# Supabase - kopieer dit bestand naar .env.local en vul je waarden in.
# Haal keys op in je Supabase dashboard: Settings > API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alleen server-side gebruiken (nooit naar de browser sturen).
SUPABASE_SERVICE_ROLE_KEY=

# Admin-e-mail dat toegang krijgt tot /admin via RLS-policy.
NEXT_PUBLIC_ADMIN_EMAIL=marcus.bergez@gmail.com
