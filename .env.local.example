# Supabase - kopieer dit bestand naar .env.local en vul je waarden in.
# Haal keys op in je Supabase dashboard: Settings > API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alleen server-side gebruiken (nooit naar de browser sturen).
SUPABASE_SERVICE_ROLE_KEY=

# Admin-e-mail dat toegang krijgt tot /admin via RLS-policy.
NEXT_PUBLIC_ADMIN_EMAIL=marcus.bergez@gmail.com

# Volledige site-URL (gebruikt voor magic-link redirects).
# Lokaal: http://localhost:3000  — Productie: https://jouw-domein.be
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (transactionele e-mails: bevestigingen, zaak-meldingen, digest).
# Dev-modus: EMAIL_FROM=onboarding@resend.dev stuurt alleen naar je Resend-account-mail.
# Productie: verifieer eerst een domein in Resend en gebruik 'noreply@jouwdomein.be'.
RESEND_API_KEY=
EMAIL_FROM="Last-minute Gent <onboarding@resend.dev>"

# Factuurbedrag per doorgegane afspraak (zichtbaar in /admin/overzicht).
NEXT_PUBLIC_FEE_PER_SHOW=3

# Meta Pixel voor Instagram/Facebook-advertenties.
# Pixel laadt enkel na toestemming via de cookiebanner.
# Leeg laten om Meta Pixel uit te schakelen.
NEXT_PUBLIC_META_PIXEL_ID=
